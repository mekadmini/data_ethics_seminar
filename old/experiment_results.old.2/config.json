{
    "matrix_language": "it",
    "embedded_languages": [
        "ar",
        "el",
        "es"
    ],
    "swap_ratio": 0.9,
    "language_weights": {
        "el": 0.5,
        "ar": 0.3,
        "es": 0.2
    },
    "batch_size": 1,
    "content_swaps": true,
    "func_swaps": true,
    "dataset_split": "train[:1]",
    "experiment_name": "default_experiment",
    "use_google_api": false,
    "translation_iterations": 2
}